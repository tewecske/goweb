# Example environment for local development.
#
# Copy to `.env` and load it before running the server:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   go run ./cmd/web
#
# Every value below is a throwaway example, not a real credential. Replace the
# secrets before using this configuration anywhere shared.

# --- Runtime ---
GOWEB_ENV=development
GOWEB_HTTP_ADDR=127.0.0.1:8080
GOWEB_PUBLIC_URL=http://localhost:8080
GOWEB_SESSION_COOKIE_SECURE=false
GOWEB_EMAIL_CONFIRMATION_REQUIRED=false
GOWEB_SESSION_LIFETIME=24h

# --- Retention ---
# Empty abandoned guests, sign-in history, and usage events.
GOWEB_GUEST_RETENTION=720h
GOWEB_LOGIN_ATTEMPT_RETENTION=720h
GOWEB_USAGE_RETENTION=2160h

# --- Optional infrastructure ---
# Outgoing mail relay without credentials (credentials are rejected).
# GOWEB_MAIL_RELAY=smtp://mail.example.test:587
# Trusted proxy IP address or CIDR network.
# GOWEB_TRUSTED_PROXY=10.0.0.0/8

# --- Development bootstrap administrator ---
# Seeded on startup when the database is configured. Non-production only.
# Remove both values or leave them empty to disable seeding.
GOWEB_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
GOWEB_BOOTSTRAP_ADMIN_PASSWORD=bootstrap-admin-password

# --- Secrets ---
# Must contain at least 32 characters. Generate with: openssl rand -base64 48
GOWEB_SESSION_SECRET=VbgKilgtzPeZZ5F697euooIZacjVm47tIR84idg8kfoSkK

# --- PostgreSQL (must match compose.yaml) ---
# POSTGRES_PORT defaults to 55432 so the container never collides with a
# PostgreSQL already listening on the standard 5432.
POSTGRES_USER=goweb
POSTGRES_PASSWORD=558f9efb62fd4e74f8b06f9723b30f5f
POSTGRES_DB=goweb
POSTGRES_PORT=55432

# Must reference the same user, password, database, and port as POSTGRES_* above.
GOWEB_DATABASE_URL=postgres://goweb:558f9efb62fd4e74f8b06f9723b30f5f@localhost:55432/goweb?sslmode=disable
