# Example environment for local development.
#
# Copy to `.env` and load it before running the server:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   go run ./cmd/web
#
# Every value below is a throwaway example, not a real credential. Replace the
# secrets before using this configuration anywhere shared.

# --- Runtime ---
GOWEB_ENV=development
GOWEB_HTTP_ADDR=127.0.0.1:8080
GOWEB_PUBLIC_URL=http://localhost:8080
GOWEB_SESSION_COOKIE_SECURE=false
GOWEB_EMAIL_CONFIRMATION_REQUIRED=false
GOWEB_SESSION_LIFETIME=24h

# --- Retention ---
# Empty abandoned guests, sign-in history, and usage events.
GOWEB_GUEST_RETENTION=720h
GOWEB_LOGIN_ATTEMPT_RETENTION=720h
GOWEB_USAGE_RETENTION=2160h

# --- Optional infrastructure ---
# Outgoing mail relay without credentials (credentials are rejected); required in
# production. smtp:// upgrades with STARTTLS when offered; smtps:// uses TLS.
# Locally, point it at a mail catcher such as Mailpit to read messages:
# GOWEB_MAIL_RELAY=smtp://localhost:1025
# Or deliver through the Resend HTTP API (set only one of the two; the sender
# must be on a domain verified in Resend):
# GOWEB_RESEND_API_KEY=re_...
# GOWEB_MAIL_FROM=no-reply@example.test
# Trusted proxy IP address or CIDR network. Set behind a reverse proxy so rate
# limits and audit records use the client IP from X-Forwarded-For.
# GOWEB_TRUSTED_PROXY=10.0.0.0/8

# --- Optional Google sign-in ---
# Set both values to show a Google button on the sign-in and sign-up pages.
# Register the redirect URL (defaults to GOWEB_PUBLIC_URL + the path below)
# as an authorized redirect URI in the Google Cloud console.
# GOWEB_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOWEB_GOOGLE_CLIENT_SECRET=your-client-secret
# GOWEB_GOOGLE_REDIRECT_URL=http://localhost:8080/en/oauth/google/callback

# --- Optional single sign-on role (docs/sso-hydra-plan.md) ---
# local (default), provider, or client. provider and client need the database.
# For a local client app, `make sso-client` writes .env.client and
# `make run-client` starts it on 127.0.0.1:8081.
# GOWEB_AUTH_MODE=local
# Where the SSO dev stack (make sso-up, run-provider, sso-client, run-client)
# listens and how browsers reach it. Defaults keep everything on this machine:
# provider http://localhost:8080, client http://127.0.0.1:8081, Hydra
# http://127.0.0.1:4444. To test from another machine on a private network
# such as a tailnet, bind to this machine's address there and give the
# provider and client different host names (cookies ignore ports), e.g.:
# SSO_DEV_BIND=100.x.y.z
# SSO_DEV_ISSUER_URL=http://myhost.tailnet.ts.net:4444
# SSO_DEV_PROVIDER_URL=http://100.x.y.z:8080
# SSO_DEV_CLIENT_URL=http://myhost.tailnet.ts.net:8081
# The issuer must use port 4444 and the client port 8081; Hydra's admin API
# always stays on loopback.
#
# Single sign-on checks: `make sso-contract` (throwaway Hydra, only Docker) and
# `make sso-e2e` (browser specs against the running stack; its password-reset
# scenario needs the provider started with GOWEB_MAIL_RELAY=smtp://localhost:1025).
#
# Provider and client: Hydra's public URL (the OpenID Connect issuer).
# GOWEB_SSO_ISSUER_URL=http://127.0.0.1:4444
# Provider only: the private Hydra admin API.
# GOWEB_HYDRA_ADMIN_URL=http://127.0.0.1:4445
# Client only: values printed by `make sso-client`. Run clients on 127.0.0.1,
# not localhost, so their cookies do not collide with the provider's.
# GOWEB_SSO_CLIENT_ID=goweb-dev-client
# GOWEB_SSO_CLIENT_SECRET=<printed by make sso-client>
# GOWEB_SSO_ACCOUNT_URL=http://localhost:8080/en/account/settings

# --- Development bootstrap administrator ---
# Seeded on startup when the database is configured. Non-production only.
# Remove both values or leave them empty to disable seeding.
GOWEB_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
GOWEB_BOOTSTRAP_ADMIN_PASSWORD=bootstrap-admin-password

# --- Secrets ---
# Must contain at least 32 characters. Generate with: openssl rand -base64 48
GOWEB_SESSION_SECRET=VbgKilgtzPeZZ5F697euooIZacjVm47tIR84idg8kfoSkK

# --- PostgreSQL (must match compose.yaml) ---
# POSTGRES_PORT defaults to 55432 so the container never collides with a
# PostgreSQL already listening on the standard 5432.
POSTGRES_USER=goweb
POSTGRES_PASSWORD=558f9efb62fd4e74f8b06f9723b30f5f
POSTGRES_DB=goweb
POSTGRES_PORT=55432

# --- Optional single sign-on infrastructure (make sso-up) ---
# Ory Hydra's own database role and secrets. compose.yaml falls back to
# development-only placeholders; production values come from a secret manager.
# HYDRA_DB_PASSWORD=hydra-dev-only-password
# HYDRA_SECRETS_SYSTEM=<at least 32 random characters>
# HYDRA_SECRETS_COOKIE=<at least 32 random characters>

# Must reference the same user, password, database, and port as POSTGRES_* above.
GOWEB_DATABASE_URL=postgres://goweb:558f9efb62fd4e74f8b06f9723b30f5f@localhost:55432/goweb?sslmode=disable
