# Settings for deploy/run-client.sh (one client app). Copy to a private location
# (mode 600) per app and fill in the CHANGE_ME values. Get the client ID and
# secret from deploy/register-client.sh. Keep the real file out of Git.
GOWEB_ENV=production
GOWEB_AUTH_MODE=client

# Loopback only, and a port that is unique for each app on this host.
GOWEB_HTTP_ADDR=127.0.0.1:8081
GOWEB_PUBLIC_URL=https://notes.example.com
GOWEB_SESSION_COOKIE_SECURE=true
GOWEB_TRUSTED_PROXY=127.0.0.1

# This app's own database and role.
GOWEB_DATABASE_URL=postgres://goweb_notes:CHANGE_ME@127.0.0.1:5432/goweb_notes?sslmode=disable
GOWEB_SESSION_SECRET=CHANGE_ME
# Short, because a client that was down during a revocation keeps its local
# session until it expires.
GOWEB_SESSION_LIFETIME=8h

# From deploy/register-client.sh.
GOWEB_SSO_CLIENT_ID=goweb-notes
GOWEB_SSO_CLIENT_SECRET=CHANGE_ME
# Hydra's public address, and the provider's account page this app links to.
GOWEB_SSO_ISSUER_URL=https://sso.example.com
GOWEB_SSO_ACCOUNT_URL=https://auth.example.com/en/account/settings

# Production startup requires a mail relay even though a client app sends no
# mail itself (the sign-up, reset and confirmation routes are not registered).
GOWEB_MAIL_RELAY=smtp://127.0.0.1:25
GOWEB_MAIL_FROM=no-reply@example.com
