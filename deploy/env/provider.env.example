# Settings for deploy/run-provider.sh (the single sign-on provider). Copy to a
# private location (mode 600), fill in the CHANGE_ME values, and keep the real
# file out of Git. Reference: README.md and docs/deployment.md.
GOWEB_ENV=production
GOWEB_AUTH_MODE=provider

# Loopback only: the tunnel or proxy on this host reaches the app here.
GOWEB_HTTP_ADDR=127.0.0.1:8080
GOWEB_PUBLIC_URL=https://auth.example.com
GOWEB_SESSION_COOKIE_SECURE=true
# The tunnel or proxy runs on this host; without this every visitor appears to
# come from 127.0.0.1 and shares one rate-limit budget.
GOWEB_TRUSTED_PROXY=127.0.0.1

# The app's own database and role (never a superuser).
GOWEB_DATABASE_URL=postgres://goweb_provider:CHANGE_ME@127.0.0.1:5432/goweb_provider?sslmode=disable
# At least 32 characters (for example `openssl rand -hex 32`).
GOWEB_SESSION_SECRET=CHANGE_ME

# Hydra: the private admin API, and the public issuer (the same string as
# URLS_SELF_ISSUER in Hydra's env file).
GOWEB_HYDRA_ADMIN_URL=http://127.0.0.1:4445
GOWEB_SSO_ISSUER_URL=https://sso.example.com

# Required in production, credential-free (docs/deployment.md).
GOWEB_MAIL_RELAY=smtp://127.0.0.1:25
GOWEB_MAIL_FROM=no-reply@example.com
GOWEB_EMAIL_CONFIRMATION_REQUIRED=true
