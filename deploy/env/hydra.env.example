# Settings for deploy/run-hydra.sh. Copy to a private location (mode 600), fill
# in the CHANGE_ME values, and keep the real file out of Git. Hydra reads these
# names itself; see https://www.ory.com/docs/hydra/reference/configuration.

# Hydra's own database and role, separate from every app's (never a superuser).
DSN=postgres://hydra:CHANGE_ME@127.0.0.1:5432/hydra?sslmode=disable

# Two long random secrets (for example `openssl rand -hex 32`). Rotating the
# system secret needs Hydra's rotation procedure; do not lose it.
SECRETS_SYSTEM=CHANGE_ME
SECRETS_COOKIE=CHANGE_ME

# Loopback only: your tunnel or proxy reaches Hydra here. The admin API listens
# on 127.0.0.1:4445 (hydra.yml) and must never be exposed.
SERVE_PUBLIC_HOST=127.0.0.1

# Hydra's public address, the OpenID Connect issuer. Apps and the provider must
# use exactly this string as GOWEB_SSO_ISSUER_URL (no trailing slash).
URLS_SELF_ISSUER=https://sso.example.com

# The provider's browser-facing pages Hydra redirects to.
URLS_LOGIN=https://auth.example.com/sso/login
URLS_CONSENT=https://auth.example.com/sso/consent
URLS_LOGOUT=https://auth.example.com/sso/logout
URLS_POST_LOGOUT_REDIRECT=https://auth.example.com/en/sign-in
URLS_ERROR=https://auth.example.com/sso/error
